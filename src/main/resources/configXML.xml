<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans 
                           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="XMLService" class="com.config.xmlConfig.XMLServices"/>

    <bean id="XMLController" class="com.config.xmlConfig.XMLController">
        <property name="serve" ref="XMLService"/>
    </bean>
    
    <bean id="constructorBean" class="com.config.xmlConfig.XMLConstructorBean">
    	<constructor-arg ref="XMLService"/>
    </bean>

</beans>
